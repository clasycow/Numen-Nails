{
  "name": "numen-studio",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-17",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "numennails.com/api/studio/*", "zone_name": "numennails.com" }],
  "vars": {
    "SITE_ORIGIN": "https://numennails.com",
    "ACCESS_TEAM_DOMAIN": "REPLACE_WITH_YOUR_TEAM.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE_WITH_OWNER_APP_AUDIENCE",
    "ADMIN_EMAILS": "REPLACE_WITH_OWNER_EMAIL",
    "REMINDERS_ENABLED": "false"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "numen-studio", "database_id": "REPLACE_WITH_DATABASE_ID", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "numen-studio-media" }],
  "kv_namespaces": [{ "binding": "INQUIRY_RATE_LIMIT", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }],
  "triggers": { "crons": ["*/15 * * * *"] }
}
